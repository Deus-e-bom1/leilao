# Supabase (obrigatório)
SUPABASE_URL=https://seu-projeto.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
SUPABASE_PROJECT_ID=seu-project-id
VITE_SUPABASE_URL=https://seu-projeto.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
VITE_SUPABASE_PROJECT_ID=seu-project-id

# Supabase service role (necessário para webhook Pix e funções administrativas)
SUPABASE_SERVICE_ROLE_KEY=sb_secret_...

# Pagamento Pix via Skalepay
SKALEPAY_API_KEY=sua-chave-skalepay

# Rastreamento de vendas via Utmify
UTMIFY_API_TOKEN=seu-token-utmify

# URL final do site na Vercel (usada em webhooks e redirecionamentos)
LOVABLE_PROJECT_URL=https://seu-site.vercel.app
